{
  "name": "slopcord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "node src/index.ts",
    "check": "tsc --noEmit && tsc --noEmit -p web",
    "smoke": "node test/smoke.ts",
    "upload-check": "node test/upload-check.ts",
    "mcp-check": "node test/mcp-check.ts",
    "compact-check": "node test/compact-check.ts",
    "media-check": "node test/media-check.ts",
    "routing-check": "DATA_DIR=$(mktemp -d) node test/routing-check.ts",
    "gif-check": "node test/gif-check.ts",
    "permissions-check": "node test/permissions-check.ts",
    "memory-check": "DATA_DIR=$(mktemp -d) node test/memory-check.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@hono/node-server": "2.1.6",
    "@playwright/mcp": "0.0.84",
    "@sapphire/framework": "5.5.1",
    "discord.js": "14.28.1",
    "hono": "4.13.17",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
